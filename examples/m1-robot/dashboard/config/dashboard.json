  "groups": [
    {"id": "head", "label": "头部"},
    {"id": "left_arm", "label": "左臂"},
    {"id": "right_arm", "label": "右臂"},
    {"id": "left_leg", "label": "左腿"},
    {"id": "right_leg", "label": "右腿"}
  ],
  "topics": {
    "joints": {"name": "/HardwareKinematic_topic", "type": "hardware/msg/KinematicState", "stale_after": 1.0},
    "imu": {"name": "/HardwareImuStd_topic", "type": "sensor_msgs/msg/Imu", "stale_after": 1.0},
    "battery": {"name": "/HardwareBat_topic", "type": "hardware/msg/Bat", "stale_after": 3.0},
    "head": {"name": "/HardwareHeadPosition_topic", "type": "hardware/msg/HeadPosition", "stale_after": 3.0},
    "vehicle": {"name": "/HardwareVehicleFeedback_topic", "type": "hardware/msg/VehicleFeedback", "stale_after": 3.0},
    "motion_feedback": {"name": "/ControlBipedMotionFeedback_topic", "type": "plan/msg/BipedMotionCmd", "stale_after": 1.0},
    "self_fall": {"name": "/HardwareSelfFall_topic", "type": "std_msgs/msg/UInt32", "stale_after": 3.0},
    "motor_current": {"name": "/HardwareMotorCurrent_topic", "type": "std_msgs/msg/Int16MultiArray", "stale_after": 3.0},
    "motor_load": {"name": "/HardwareMotorLoad_topic", "type": "std_msgs/msg/Int16MultiArray", "stale_after": 3.0},
    "motor_temp": {"name": "/HardwareMotorTemp_topic", "type": "std_msgs/msg/UInt8MultiArray", "stale_after": 3.0},
    "motor_error": {"name": "/HardwareMotorErr_topic", "type": "std_msgs/msg/UInt8MultiArray", "stale_after": 3.0},
    "lidar": {"name": "/HardwareLidar_topic", "type": "sensor_msgs/msg/LaserScan", "stale_after": 3.0},
    "itof": {"name": "/HardwareItof/camera_info", "type": "sensor_msgs/msg/CameraInfo", "stale_after": 3.0},
    "camera": {"name": "/camera/camera_info", "type": "sensor_msgs/msg/CameraInfo", "stale_after": 4.0},
    "audio": {"name": "/audio/capture_pcm", "type": "sensor_msgs/msg/Image", "stale_after": 2.0},
    "audio_keyword": {"name": "/audio/kw_detect", "type": "std_msgs/msg/Int32MultiArray", "stale_after": 30.0},
    "go_charge_done": {"name": "/ControlGoChargeDone_topic", "type": "std_msgs/msg/UInt8", "stale_after": 300.0}
  },
  "sensors": {
    "lidar": {"label": "2D LiDAR", "topic_key": "lidar", "presence_topic": "/HardwareLidar_topic"},
    "itof": {"label": "iTOF 深度相机", "topic_key": "itof", "presence_topic": "/HardwareItof/depth_image"},
    "camera": {"label": "RGB 相机", "topic_key": "camera", "presence_topic": "/camera/image_h264"},
    "audio": {"label": "麦克风 / 音频", "topic_key": "audio", "presence_topic": "/audio/capture_pcm"}
  },
  "units": {
    "joint_angle": "degree (°)",
    "joint_velocity": "MCU int16 raw value (official unit not specified)",
    "head_angle": "degree (°), raw value / 100",
    "angular_velocity": "rad/s",
    "linear_acceleration": "m/s²",
    "battery_voltage": "V, bat_vol mV / 1000",
    "wheel_speed": "MCU int32 raw value (official unit not specified)"
  },
  "sources": [
    "Robot runtime ROS 2 graph and message samples",
    "/app/joyin/config/robot.urdf and hardware_pm.json",
    "https://github.com/ZerothRobot/Zeroth-M1_EDU_Deploy/blob/main/api/readme_cn.md"
  ]
}
