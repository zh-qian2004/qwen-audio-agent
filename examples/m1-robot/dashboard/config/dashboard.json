{
  "host": "127.0.0.1",
  "port": 8080,
  "push_rate_hz": 10,
  "history_seconds": 60,
  "battery_history_seconds": 21600,
  "battery_history_sample_seconds": 15,
  "battery_history_log": "auto",
  "audio": {
    "topic": "/audio/capture_pcm",
    "base_url": "http://127.0.0.1:8091",
    "level_path": "/api/audio/level",
    "ws_path": "/ws/audio/input?delivery=continuous&pre_roll_ms=0",
    "poll_interval_seconds": 0.1,
    "request_timeout_seconds": 1.0,
    "reconnect_min_seconds": 0.5,
    "reconnect_max_seconds": 5.0,
    "source_label": "厂商 media_audio 处理后麦克风流",
    "sample_rate_hz": 16000,
    "sample_format": "S16_LE",
    "channels": 1,
    "stale_after_seconds": 2
  },
  "tts": {
    "enabled": true,
    "base_url": "http://127.0.0.1:8091",
    "speaker_topic": "/audio/speaker_pcm",
    "max_text_length": 300,
    "queue_capacity": 8,
    "status_timeout_seconds": 2,
    "speak_timeout_seconds": 8,
    "cache_ttl_seconds": 0.8,
    "refresh_interval_seconds": 1.0
  },
  "audio_agent": {
    "stale_after_seconds": 6
  },
  "vision": {
    "enabled": true,
    "base_url": "http://127.0.0.1:8092",
    "request_timeout_seconds": 1.5,
    "cache_ttl_seconds": 0.8,
    "refresh_interval_seconds": 1.0
  },
  "speaker_volume": {
    "card": "duplexaudio",
    "controls": ["DAC"],
    "min_percent": 0,
    "max_percent": 100,
    "min_db_gain": -95.5,
    "max_db_gain": 8,
    "db_step": 0.5,
    "timeout_seconds": 3,
    "cache_ttl_seconds": 1
  },
  "joints": [
