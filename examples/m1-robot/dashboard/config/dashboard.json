    {"index": 14, "name": "right_leg_hip_yaw", "label": "右髋偏航", "group": "right_leg", "min": -16.0, "max": 16.0},
    {"index": 15, "name": "right_leg_hip_roll", "label": "右髋侧摆", "group": "right_leg", "min": -20.0, "max": 20.0},
